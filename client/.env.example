# ============================================
# HMorix Client - Environment Variables
# ============================================

# Application URL (used for OAuth redirects, email verification, etc.)
VITE_APP_URL=https://orix-pink.vercel.app

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# API Configuration
VITE_API_URL=https://orix-pink.vercel.app/api

# NVIDIA AI is called through /api/ai/* so the key stays server-side.
# Set NVIDIA_API_KEY and NVIDIA_MODEL in the root/backend environment.

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_ASSISTANT=true
