# Copy this to .env and fill in the blank values below (your real API keys /
# Supabase credentials). Everything else already has a sensible default —
# only change it if you want different behavior.

# --- Secrets: fill these in, keep them out of git/chat -----------------
NVIDIA_API_KEYS=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=


# Optional: real Google ranking checks via the Custom Search JSON API (free,
# 100 queries/day). Setup:
#   1. https://programmablesearchengine.google.com/ -> Add -> search the
#      entire web (turn OFF "Search only included sites") -> copy its ID below
#   2. https://console.cloud.google.com/apis/credentials -> Create API key,
#      enable "Custom Search API" for the project -> paste below
# Without these, --check-rankings and the ranking-aware parts of
# --suggest-topics are skipped rather than guessed.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# --- NVIDIA models -------------------------------------------------------
# Current (as of July 2026) confirmed-working free NVIDIA NIM models.
# NVIDIA's free catalog changes model availability with little notice --
# if one of these starts 404ing, swap it here or in NVIDIA_MODEL_CHAIN below.
NVIDIA_MODEL_WRITER=meta/llama-4-maverick-17b-128e-instruct
NVIDIA_MODEL_FAST=nvidia/llama-3.3-nemotron-super-49b-v1
# Optional: override the full fallback chain (comma-separated, tried in order)
# NVIDIA_MODEL_CHAIN=
# Optional: per-request timeout in ms (default 60000) and total retry budget
# in ms (default 720000 = 12 min)
# NVIDIA_TIMEOUT_MS=60000
# NVIDIA_MAX_WAIT_MS=720000

# --- Supabase notes --------------------------------------------------------
# SUPABASE_URL is your project's REST URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY is the service_role JWT from
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# This is NOT the same as your database password from a
# postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
# connection string -- that's for direct DB connections, unrelated to the
# REST API this project uses. A 401 "Invalid API key" almost always means
# this value is missing, wrong, or a database password was pasted here by mistake.

# --- Site / brand info -----------------------------------------------------
SITE_URL=https://hmorix.in
SITE_NAME=HMorix

# Used by agent/daily_topic_planner.py to generate blog topics aimed at
# ranking your brand/founder name on Google (e.g. someone searching your
# brand, a similar-sounding variant, or your name should find your content).
BRAND_NAME=Your Brand
BRAND_NAME_VARIANTS=Morix,Orix,himorix,homorix,hemorix,morix,
FOUNDER_NAME=Harsh Sharma
FOUNDER_ROLES=CEO,Founder,Owner

# Shown on every generated page/JSON-LD as the author.
BLOG_AUTHOR_NAME=HMorix AI
BLOG_AUTHOR_ROLE=Resarch Agent Team

# Used by scripts/render_page.py for the "Back to Blog" link on rendered pages
BLOG_INDEX_URL=/blog


# --- Scheduler ---------------------------------------------------------
# The daily batch (see workflows/daily_scheduler.py): only runs while
# web_server.py stays running (a phone/Termux process gets killed when the
# app closes, so this is best-effort, not a guaranteed OS-level schedule --
# see the docstring in daily_scheduler.py for cron/Termux:Job alternatives).
ENABLE_DAILY_SCHEDULER=false
SCHEDULE_HOUR=6

# --- Publishing ----------------------------------------------------------
# Set to false to go back to draft-only (manual review before publish).
AUTO_PUBLISH=true

# --- Web UI ----------------------------------------------------------------
WEB_UI_PORT=8787
WEB_UI_HOST=0.0.0.0

# --- Output paths (optional overrides) --------------------------------
# Where generated frontend files land. Point these at your actual frontend
# repo's paths once you know them -- defaults write under ./generated/.
BLOG_PAGES_OUTPUT_DIR=../../../client/src/generated/blog-pages
POSTS_INDEX_FILE=../../../client/src/generated/postsIndex.json
SITEMAP_OUTPUT_PATH=../../../client/public/sitemap.xml
RSS_OUTPUT_PATH=../../../client/public/rss.xml
CASE_STUDY_PAGES_OUTPUT_DIR=../../../client/src/generated/case-study-pages
CASE_STUDIES_INDEX_FILE=../../../client/src/generated/caseStudiesIndex.json
WHITEPAPER_PAGES_OUTPUT_DIR=../../../client/src/generated/whitepaper-pages
WHITEPAPERS_INDEX_FILE=../../../client/src/generated/whitepapersIndex.json
WHITEPAPER_PDF_OUTPUT_DIR=../../../client/public/whitepaper-pdfs
PRESS_PAGES_OUTPUT_DIR=../../../client/src/generated/press-pages
PRESS_INDEX_FILE=../../../client/src/generated/pressIndex.json
PRESS_PDF_OUTPUT_DIR=../../../client/public/press-pdfs
# RENDERED_CASE_STUDY_PAGES_DIR=

# Static (non-blog-post) pages included in the sitemap: "path:changefreq:priority"
# comma-separated. Add your actual service/product page routes here.
# STATIC_SITEMAP_PATHS=

# Optional: cap how many RSS items are kept in the feed (default 50)
# RSS_ITEM_LIMIT=50

# Optional: daily batch counts (see workflows/daily_scheduler.py)
# DAILY_BRAND_AUTO_COUNT=3
# DAILY_PRODUCT_AUTO_COUNT=2
# DAILY_TRENDING_APPROVAL_COUNT=2
