:root { --lightningcss-light: initial; --lightningcss-dark: ; color-scheme: light; }

:root.dark { --lightningcss-light: ; --lightningcss-dark: initial; color-scheme: dark; }

@keyframes loading-fade { 
  0% { opacity: 0; }
  8%, 30% { opacity: 1; }
  40%, 100% { opacity: 0; }
}

@keyframes journey-enter { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes journey-fade { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes agent-waiting-glimmer { 
  0%, 18% { background-position: 145% center; }
  72%, 100% { background-position: -45% center; }
}

@keyframes score-pie-enter { 
  0% { stroke-dashoffset: 100px; }
}

.score-pie-progress { stroke-dasharray: 100; transition: stroke-dashoffset 0.5s cubic-bezier(0.65, 0, 0.35, 1); animation: 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0s 1 normal both running score-pie-enter; }

.agent-waiting-glimmer { color: rgba(0, 0, 0, 0); background-image: linear-gradient(105deg, var(--color-neutral-500) 0%, var(--color-neutral-500) 39%, var(--color-neutral-950) 49%, var(--color-neutral-500) 59%, var(--color-neutral-500) 100%); animation: var(--animate-agent-waiting-glimmer); background-position: 145% center; background-size: 240% 100%; background-clip: text; display: inline-block; }

.agent-score-glimmer { color: rgba(0, 0, 0, 0); background-image: linear-gradient(105deg, var(--color-neutral-950) 0%, var(--color-neutral-950) 39%, var(--color-neutral-400) 49%, var(--color-neutral-950) 59%, var(--color-neutral-950) 100%); animation: var(--animate-agent-waiting-glimmer); background-position: 145% center; background-size: 240% 100%; background-clip: text; display: inline-block; }

.dark .agent-waiting-glimmer { background-image: linear-gradient(105deg, var(--color-neutral-400) 0%, var(--color-neutral-400) 39%, var(--color-white) 49%, var(--color-neutral-400) 59%, var(--color-neutral-400) 100%); }

.dark .agent-score-glimmer { background-image: linear-gradient(105deg, var(--color-neutral-100) 0%, var(--color-neutral-100) 39%, var(--color-neutral-600) 49%, var(--color-neutral-100) 59%, var(--color-neutral-100) 100%); }

.agentic-pixel-cycle { font-family: var(--font-geist-pixel), var(--font-geist-sans), sans-serif; font-variation-settings: "ELSH" 0; font-synthesis: none; font-weight: 300; animation: 8s cubic-bezier(0.65, 0, 0.35, 1) 0s infinite alternate none running agentic-pixel-cycle; display: inline-block; }

@keyframes agentic-pixel-cycle { 
  0% { font-variation-settings: "ELSH" 0; }
  100% { font-variation-settings: "ELSH" 100; }
}

@media (prefers-reduced-motion: reduce) {
  .agent-waiting-glimmer { color: var(--color-neutral-500); background: 0px 0px; animation: auto ease 0s 1 normal none running none; }
  .agent-score-glimmer { color: var(--color-neutral-950); background: 0px 0px; animation: auto ease 0s 1 normal none running none; }
  .dark .agent-waiting-glimmer { color: var(--color-neutral-400); }
  .dark .agent-score-glimmer { color: var(--color-neutral-100); }
  .agentic-pixel-cycle { animation: auto ease 0s 1 normal none running none; }
  .score-pie-progress { transition: none; animation: auto ease 0s 1 normal none running none; }
  *, ::before, ::after { scroll-behavior: auto !important; }
}

@media (forced-colors: active) {
  .agent-waiting-glimmer, .agent-score-glimmer { color: canvastext; background: 0px 0px; animation: auto ease 0s 1 normal none running none; }
  .score-pie-progress { stroke: canvastext; }
}

